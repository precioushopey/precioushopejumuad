# Copy to .env.local for local work with `vercel dev`. Never commit the real file (.gitignore blocks it).
# In production these are set in Vercel: Project > Settings > Environment Variables.

# API key from resend.com. Server-side only: it is read by api/contact.ts and never reaches the browser.
RESEND_API_KEY=

# Optional: where contact messages are delivered. Defaults to the address in api/contact.ts.
# With Resend's free sender this must be the email the Resend account uses.
CONTACT_TO_EMAIL=
